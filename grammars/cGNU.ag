/*
 * C as gcc takes it, in every standard and with GNU extensions, on all C files of a
 * large corpus. It starts as a copy of c90.ag, and syntax is added wherever the corpus
 * shows a gap. It is meant to be general: narrower grammars can follow from it, such
 * as one only collecting identifiers, or particular versions of GNU C.
 *
 * Typedef names come from the name table: the parser declares names as it reduces,
 * and an identifier whose innermost declaration is a type reaches the grammar as
 * TypedefName. Scopes close before the closing brace or parenthesis, so the next
 * token is classified in the right scope. Names in their own namespaces, such as
 * members, tags and labels, accept both tokens through anyName. int f(int (T))
 * declares a parameter T even when T is a type, where ISO C reads a parameter of
 * function type.
 *
 * Implicit int is allowed where gcc -std=c90 -pedantic-errors allows it: function
 * definitions, and declarations with a storage class or a qualifier. A declarator
 * there cannot start with a typedef name, as that name would be the type.
 */

grammar CGNU;

options {
    parser = LR;
    lookahead = 1;
    ast = explicit;
}

channels {
    HIDDEN
}

/*
 * An attribute after a declarator belongs to that declarator. So a K&R parameter
 * declaration cannot start with an attribute: int f(a) __attribute__((x)) int a; { }
 * _Atomic followed by a parenthesis is the type specifier, unless a qualifier came
 * first, as in const _Atomic (int). In a member, enum E : 3 is a bit-field, so such a
 * member cannot use an enum with an underlying type.
 */
conflicts {
    prefer shift Else over reduce ifScopeClose#IfScopeClose;
    prefer reduce declaratorSuffixes#NoSuffix over shift AttributeWord;
    prefer reduce declaratorSuffixes#NoSuffix over shift StandardAttributeOpen;
    prefer shift LeftParenthesis over reduce atomicQualifier#PlainAtomic;
    prefer reduce qualifierList#Qualifiers over shift AtomicWord;
    prefer reduce enumSpecifier#EnumReference over shift Colon;
}

node compilationUnit
    : directive=FirstDirective? declarations=externalDeclaration* EOF
    ;

node externalDeclaration
    : value=functionDefinition
    | value=declaration
    | '__extension__' value=externalDeclaration
    | value=asmStatement
    ;

node declaration
    : value=initDeclaration
    | value=typeDefinition
    | value=staticAssertion
    | ';'
    ;

node staticAssertion
    : '_Static_assert' '(' condition=constantExpression ')' ';'
    | '_Static_assert' '(' condition=constantExpression ',' message=StringLiteral+ ')' ';'
    | 'static_assert' '(' condition=constantExpression ')' ';'
    | 'static_assert' '(' condition=constantExpression ',' message=StringLiteral+ ')' ';'
    ;

node functionDefinition
    : type=declarationSpecifiers declarator=declaredName parameters=parametersKandRList? body=functionBody
    | declarator=implicitDeclaredName parameters=parametersKandRList? body=functionBody
    | implied=impliedSpecifiers declarator=implicitDeclaredName parameters=parametersKandRList? body=functionBody
    ;

/* The body reopens the scope of the parameters of the function declarator. */
node functionBody
    : LeftBrace scopeReopen items=blockItem* last=finalLabel? scopeClose RightBrace
    ;

node initDeclaration
    : type=declarationSpecifiers declarators=initDeclaratorList? ';'
    | implied=impliedSpecifiers declarators=implicitInitDeclaratorList ';'
    ;

/*
 * Specifiers of a declaration in any order, as C90 allows. A declaration goes through
 * up to three stages: only storage classes and qualifiers, which imply int; then a
 * keyword type or one typedef name. A typedef name after a keyword type is the
 * declared name, so it cannot continue the specifiers. typedef itself can appear at
 * any stage, and the same three stages after it decide that declarators declare types.
 */
inline declarationSpecifiers
    : value=keywordSpecifiers
    | value=namedSpecifiers
    ;

inline typedefSpecifiers
    : value=typedefKeywordSpecifiers
    | value=typedefNamedSpecifiers
    ;

inline declarationItem
    : value=storageClass
    | value=typeQualifier
    ;

node impliedSpecifiers
    : item=declarationItem
    | list=impliedSpecifiers item=declarationItem
    ;

node keywordSpecifiers
    : keyword=keywordSpecifier
    | list=impliedSpecifiers keyword=keywordSpecifier
    | list=keywordSpecifiers keyword=keywordSpecifier
    | list=keywordSpecifiers item=declarationItem
    ;

node namedSpecifiers
    : name=typeWord
    | list=impliedSpecifiers name=typeWord
    | list=namedSpecifiers item=declarationItem
    ;

node typedefImpliedSpecifiers
    : 'typedef'
    | list=impliedSpecifiers 'typedef'
    | list=typedefImpliedSpecifiers item=declarationItem
    ;

node typedefKeywordSpecifiers
    : list=typedefImpliedSpecifiers keyword=keywordSpecifier
    | list=keywordSpecifiers 'typedef'
    | list=typedefKeywordSpecifiers keyword=keywordSpecifier
    | list=typedefKeywordSpecifiers item=declarationItem
    ;

node typedefNamedSpecifiers
    : list=typedefImpliedSpecifiers name=typeWord
    | list=namedSpecifiers 'typedef'
    | list=typedefNamedSpecifiers item=declarationItem
    ;

node implicitInitDeclaratorList
    : first=implicitInitDeclarator rest=initDeclaratorListGroup1*
    ;

node implicitInitDeclarator
    : declarator=implicitDeclaredName suffixes=declaratorSuffixes
    | declarator=implicitDeclaredName suffixes=declaratorSuffixes '=' initializer=initializer
    ;

inline implicitDeclaredName -> declare(Identifier)
    : value=implicitDeclarator
    ;

node implicitDeclarator
    : direct=implicitDirectDeclarator
    | pointer=pointer direct=directDeclarator
    ;

node implicitDirectDeclarator
    : name=implicitName
    | '(' value=declarator ')'
    | base=implicitDirectDeclarator parameters=functionParameters
    | base=implicitDirectDeclarator array=array
    ;

inline implicitName -> captureName
    : value=Identifier
    ;

node storageClass
    : keyword='static'
    | keyword='extern'
    | keyword='auto'
    | keyword='register'
    | keyword='inline'
    | keyword='__inline'
    | keyword='__inline__'
    | keyword='__thread'
    | keyword='_Thread_local'
    | keyword='thread_local'
    | keyword='_Noreturn'
    | keyword='constexpr'
    | keyword=alignasKeyword '(' alignment=commaExpression ')'
    | keyword=alignasKeyword '(' type=typeName ')'
    ;

inline alignasKeyword
    : value='_Alignas'
    | value='alignas'
    ;

node type
    : value=specifiers
    ;

/* A typedef name is the only specifier of a type, apart from qualifiers. */
node specifiers
    : first=keywordSpecifier rest=tailSpecifier*
    | qualifiers=qualifierList first=keywordSpecifier rest=tailSpecifier*
    | name=typeWord
    | name=typeWord after=qualifierList
    | qualifiers=qualifierList name=typeWord
    | qualifiers=qualifierList name=typeWord after=qualifierList
    ;

node qualifierList
    : items=typeQualifier+ #Qualifiers
    ;

node tailSpecifier
    : value=keywordSpecifier
    | value=typeQualifier
    ;

node keywordSpecifier
    : keyword='int'
    | keyword='char'
    | keyword='short'
    | keyword='long'
    | keyword='float'
    | keyword='double'
    | keyword='void'
    | keyword='signed'
    | keyword='unsigned'
    | keyword='__signed'
    | keyword='__signed__'
    | keyword='_Bool'
    | keyword='_Complex'
    | keyword='__complex'
    | keyword='__complex__'
    | keyword='__int128'
    | keyword='__float80'
    | keyword='__float128'
    | keyword='__ibm128'
    | keyword='_Float16'
    | keyword='_Float32'
    | keyword='_Float64'
    | keyword='_Float128'
    | keyword='_Float32x'
    | keyword='_Float64x'
    | keyword='_Float128x'
    | keyword='_Decimal32'
    | keyword='_Decimal64'
    | keyword='_Decimal128'
    | keyword='__builtin_va_list'
    | keyword='__builtin_sysv_va_list'
    | keyword='__builtin_ms_va_list'
    | keyword='__auto_type'
    | keyword=AtomicWord LeftParenthesis type=typeName ')'
    | keyword='__int128_t'
    | keyword='__uint128_t'
    | keyword='_BitInt' '(' size=constantExpression ')'
    | keyword=typeofKeyword '(' expression=commaExpression ')'
    | keyword=typeofKeyword '(' type=typeName ')'
    | value=structSpecifier
    | value=enumSpecifier
    ;

inline typeofKeyword
    : value='typeof'
    | value='__typeof'
    | value='__typeof__'
    | value='typeof_unqual'
    | value='__typeof_unqual'
    | value='__typeof_unqual__'
    ;

/* _Atomic followed by a parenthesis is always the type specifier. */
node atomicQualifier
    : AtomicWord #PlainAtomic
    ;

node typeQualifier
    : value=atomicQualifier
    | keyword='__seg_fs'
    | keyword='__seg_gs'
    | keyword='const'
    | keyword='__const'
    | keyword='__const__'
    | keyword='volatile'
    | keyword='__volatile'
    | keyword='__volatile__'
    | keyword='restrict'
    | keyword='__restrict'
    | keyword='__restrict__'
    | value=attributeSpecifier
    ;

/* An attribute stands where a qualifier can, and in the few other places using it. */
inline attributeSpecifier
    : value=gnuAttribute
    | value=standardAttribute
    ;

node gnuAttribute
    : AttributeWord '(' '(' items=attributeList ')' ')'
    ;

/* [[...]] from C23. As [[ cannot occur in other C, it is one token. */
node standardAttribute
    : StandardAttributeOpen items=standardAttributeList RightBracket RightBracket
    ;

node standardAttributeList
    : value=standardAttributeItem
    | list=standardAttributeList ',' item=standardAttributeItem
    ;

node standardAttributeItem
    : empty
    | name=attributeName
    | name=attributeName '(' arguments=argumentExpressionList? ')'
    | scope=attributeName '::' name=attributeName
    | scope=attributeName '::' name=attributeName '(' arguments=argumentExpressionList? ')'
    ;

node attributeList
    : value=attributeItem
    | list=attributeList ',' item=attributeItem
    ;

node attributeItem
    : empty
    | name=attributeName
    | name=attributeName '(' arguments=argumentExpressionList? ')'
    ;

/* Attribute names include the keyword const. */
inline attributeName
    : value=anyName
    | value='const'
    | value='__const'
    | value='__const__'
    | value='volatile'
    | value='__volatile'
    | value='__volatile__'
    ;

/* What can follow a declarator. */
inline declaratorSuffix
    : value=attributeSpecifier
    | value=asmLabel
    ;

/* Shared lists, so that alternatives need no separate empty reductions. */
node declaratorSuffixes
    : empty                                            #NoSuffix
    | list=declaratorSuffixes item=declaratorSuffix    #MoreSuffixes
    ;

node attributeSpecifiers
    : items=attributeSpecifier*
    ;

node asmLabel
    : asmKeyword '(' name=StringLiteral+ ')'
    ;

inline asmKeyword
    : value='asm'
    | value='__asm__'
    | value='__asm'
    ;

/* An asm statement, also at file scope, with operands in up to four parts. */
node asmStatement
    : asmKeyword qualifiers=asmQualifier* '(' template=StringLiteral+ parts=asmPart* ')' ';'
    ;

inline asmQualifier
    : value='goto'
    | value='inline'
    | value='__inline'
    | value='__inline__'
    | value='const'
    | value='__const'
    | value='__const__'
    | value='volatile'
    | value='__volatile'
    | value='__volatile__'
    ;

node asmPart
    : ':' operands=asmOperandList?
    | '::' operands=asmOperandList?
    ;

node asmOperandList
    : value=asmOperand
    | list=asmOperandList ',' item=asmOperand
    ;

/* An output or input with its expression, a clobber, or a goto label. */
node asmOperand
    : constraint=asmStrings
    | constraint=asmStrings '(' value=commaExpression ')'
    | LeftBracket name=anyName RightBracket constraint=asmStrings '(' value=commaExpression ')'
    | label=anyName
    ;

node asmStrings
    : items=StringLiteral+
    ;

/* A name which may equal a typedef name without any relation to it. */
inline anyName
    : value=Identifier
    | value=typeWord
    ;

/* bool is a keyword only since C23, so it behaves like a typedef name, which it was. */
inline typeWord
    : value=TypedefName
    | value='bool'
    ;

node structSpecifier
    : head=structHead tag=anyName
    | head=structHead tag=anyName? LeftBrace members=memberDeclaration+ RightBrace
    ;

/* A shared rule, so that LR(1) need not choose between the rules above early. */
node structHead
    : keyword=structKeyword attributes=attributeSpecifier*
    ;

inline structKeyword
    : value='struct'
    | value='union'
    ;

node memberDeclaration
    : type=type declarators=memberDeclaratorList? ';'
    | value=staticAssertion
    | '__extension__' value=memberDeclaration
    ;

node memberDeclaratorList
    : first=memberDeclarator rest=memberDeclaratorListGroup1*
    ;

inline memberDeclaratorListGroup1
    : ',' value=memberDeclarator
    ;

node memberDeclarator
    : declarator=declarator suffixes=declaratorSuffix*
    | declarator=declarator? ':' width=constantExpression suffixes=declaratorSuffix*
    ;

node enumSpecifier
    : head=enumHead tag=anyName                                               #EnumReference
    | head=enumHead body=enumBody                                             #AnonymousEnum
    | head=enumHead tag=anyName body=enumBody                                 #TaggedEnum
    | head=enumHead ':' underlying=enumUnderlying body=enumBody               #AnonymousTypedEnum
    | head=enumHead tag=anyName ':' underlying=enumUnderlying body=enumBody   #TaggedTypedEnum
    ;

/* An integer type, so that its end cannot be mistaken for the start of the body. */
node enumUnderlying
    : items=enumUnderlyingWord+
    ;

inline enumUnderlyingWord
    : value='char'
    | value='short'
    | value='int'
    | value='long'
    | value='signed'
    | value='unsigned'
    | value='const'
    | value='__int128'
    | value='_Bool'
    | value=typeWord
    ;

node enumBody
    : LeftBrace enumerators=enumeratorList RightBrace
    | LeftBrace enumerators=enumeratorList ',' RightBrace
    ;

node enumHead
    : 'enum' attributes=attributeSpecifier*
    ;

node enumeratorList
    : value=enumerator
    | list=enumeratorList ',' item=enumerator
    ;

node enumerator
    : name=enumeratorName attributes=attributeSpecifiers
    | name=enumeratorName attributes=attributeSpecifiers '=' value=constantExpression
    ;

inline enumeratorName -> captureName, declare(Identifier)
    : value=anyName
    ;

node initDeclaratorList
    : first=initDeclarator rest=initDeclaratorListGroup1*
    ;

inline initDeclaratorListGroup1
    : ',' value=initDeclarator
    | ',' attributes=attributeSpecifier value=initDeclarator
    ;

node initDeclarator
    : declarator=declaredName suffixes=declaratorSuffixes
    | declarator=declaredName suffixes=declaratorSuffixes '=' initializer=initializer
    ;

/* A declarator is complete here, so its name is visible in the initializer. */
inline declaredName -> declare(Identifier)
    : value=declarator
    ;

inline declaredTypeName -> declare(TypedefName)
    : value=declarator
    ;

inline scopeOpen -> pushScope
    : empty
    ;

inline scopeClose -> popScope
    : empty
    ;

inline scopeReopen -> reopenScope
    : empty
    ;

/*
 * A single syntactic declarator represents objects, functions, arrays and
 * pointers to them. Type construction and C constraints decide which kind a
 * declaration denotes; the parser does not choose a separate branch early.
 */
node declarator
    : direct=directDeclarator
    | pointer=pointer direct=directDeclarator
    ;

node pointer
    : levels=pointerLevel+
    ;

node pointerLevel
    : '*' qualifiers=typeQualifier*
    ;

node directDeclarator
    : name=declaratorName
    | '(' value=declarator ')'
    | base=directDeclarator parameters=functionParameters
    | base=directDeclarator array=array
    ;

inline declaratorName -> captureName
    : value=anyName
    ;

node functionParameters
    : '(' scopeOpen parameters=parameterOrTypeList? scopeClose ')'
    | '(' scopeOpen variadic='...' scopeClose ')'
    | '(' scopeOpen parameters=parameterOrTypeList ',' variadic='...' scopeClose ')'
    ;

node parameterOrTypeList
    : value=parameterOrType
    | list=parameterOrTypeList ',' item=parameterOrType
    ;

/* A lone Identifier is a K&R name; a typedef name there would be a prototype. */
node parameterOrType
    : type=declarationSpecifiers
    | type=declarationSpecifiers declarator=declaredName suffixes=declaratorSuffix*
    | type=declarationSpecifiers abstract=parameterAbstractDeclarator
    | implied=impliedSpecifiers
    | implied=impliedSpecifiers declarator=implicitDeclaredName suffixes=declaratorSuffix*
    | name=Identifier
    ;

/* An unnamed parameter. Unlike abstractDeclarator it cannot start with a parameter list. */
node parameterAbstractDeclarator
    : pointer=pointer
    | direct=directParameterAbstractDeclarator
    | pointer=pointer direct=directParameterAbstractDeclarator
    ;

node directParameterAbstractDeclarator
    : '(' value=parameterAbstractDeclarator ')'
    | array=array
    | base=directParameterAbstractDeclarator parameters=functionParameters
    | base=directParameterAbstractDeclarator array=array
    ;

node parametersKandRList
    : items=parametersKandR+
    ;

node parametersKandR
    : type=declarationSpecifiers declarators=initDeclaratorList ';'
    | implied=impliedSpecifiers declarators=implicitInitDeclaratorList ';'
    ;

/* The size can be any expression, for variable length arrays. */
node array
    : LeftBracket qualifiers=arrayQualifiers size=assignmentExpression? RightBracket
    | LeftBracket qualifiers=arrayQualifiers '*' RightBracket
    ;

node arrayQualifiers
    : items=arrayQualifier*
    ;

inline arrayQualifier
    : value=typeQualifier
    | value='static'
    ;

node initializer
    : value=assignmentExpression
    | value=bracedInitializer
    ;

node bracedInitializer
    : LeftBrace RightBrace
    | LeftBrace items=initializerList RightBrace
    | LeftBrace items=initializerList ',' RightBrace
    ;

node initializerList
    : value=initializerItem
    | list=initializerList ',' item=initializerItem
    ;

node initializerItem
    : value=initializer
    | designators=designatorList '=' value=initializer
    | designators=designatorList value=initializer
    | name=anyName ':' value=initializer
    ;

node designatorList
    : value=designator
    | list=designatorList item=designator
    ;

node designator
    : LeftBracket index=constantExpression RightBracket
    | LeftBracket first=constantExpression '...' last=constantExpression RightBracket
    | '.' member=anyName
    ;

node typeDefinition
    : type=typedefSpecifiers declarators=typedefDeclaratorList ';'
    | implied=typedefImpliedSpecifiers declarators=implicitTypedefDeclaratorList ';'
    ;

node implicitTypedefDeclaratorList
    : first=implicitDeclaredTypeName suffixes=declaratorSuffix* rest=typedefDeclaratorListGroup1*
    ;

inline implicitDeclaredTypeName -> declare(TypedefName)
    : value=implicitDeclarator
    ;

node typedefDeclaratorList
    : first=declaredTypeName suffixes=declaratorSuffix* rest=typedefDeclaratorListGroup1*
    ;

inline typedefDeclaratorListGroup1
    : ',' value=suffixedTypeName
    ;

node suffixedTypeName
    : name=declaredTypeName suffixes=declaratorSuffix*
    ;

/* A type name as used by casts and sizeof. */
node typeName
    : specifiers=specifiers declarator=abstractDeclarator?
    ;

node abstractDeclarator
    : pointer=pointer
    | pointer=pointer? direct=directAbstractDeclarator
    ;

node directAbstractDeclarator
    : '(' value=abstractDeclarator ')'
    | parameters=functionParameters
    | array=array
    | base=directAbstractDeclarator parameters=functionParameters
    | base=directAbstractDeclarator array=array
    ;

node compoundStatement
    : LeftBrace scopeOpen items=blockItem* last=finalLabel? scopeClose RightBrace
    ;

/* A label without a statement exists only at the end of a block, since C23. */
node finalLabel
    : name=anyName ':'
    | keyword='case' label=constantExpression ':'
    | keyword='default' ':'
    ;

/* Declarations and statements in any order, as since C99. */
inline blockItem
    : value=localDeclaration
    | value=statement
    ;

/* Only one __extension__ here: a second one could also start an expression. */
node localDeclaration
    : value=plainLocalDeclaration
    | '__extension__' value=plainLocalDeclaration
    ;

node plainLocalDeclaration
    : type=declarationSpecifiers declarators=initDeclaratorList? ';'
    | implied=impliedSpecifiers declarators=implicitInitDeclaratorList ';'
    | value=typeDefinition
    | value=staticAssertion
    | '__label__' labels=labelNameList ';'
    | type=declarationSpecifiers declarator=declaredName parameters=parametersKandRList? body=functionBody
    | implied=impliedSpecifiers declarator=implicitDeclaredName parameters=parametersKandRList? body=functionBody
    ;

node labelNameList
    : value=anyName
    | list=labelNameList ',' item=anyName
    ;

node statement
    : value=compoundStatement
    | expression=commaExpression? ';'
    | value=ifStatement
    | keyword='while' '(' scopeOpen condition=commaExpression ')' body=statement scopeClose
    | keyword='do' scopeOpen body=statement 'while' '(' condition=commaExpression ')' scopeClose ';'
    | keyword='for' '(' init=commaExpression? ';' condition=commaExpression? ';' step=commaExpression? ')' body=statement
    | keyword='for' '(' scopeOpen declaration=plainLocalDeclaration condition=commaExpression? ';' step=commaExpression? ')' body=statement scopeClose
    | value=asmStatement
    | keyword='switch' '(' scopeOpen condition=commaExpression ')' body=statement scopeClose
    | keyword='case' label=constantExpression ':' body=statement
    | keyword='default' ':' body=statement
    | name=anyName ':' body=statement
    | name=anyName ':' declaration=plainLocalDeclaration
    | keyword='case' label=constantExpression ':' declaration=plainLocalDeclaration
    | keyword='default' ':' declaration=plainLocalDeclaration
    | attribute=attributeSpecifier ';'
    | attribute=attributeSpecifier 'return' expression=commaExpression? ';'
    | keyword='goto' target=anyName ';'
    | keyword='goto' '*' computed=commaExpression ';'
    | keyword='case' label=constantExpression '...' last=constantExpression ':' body=statement
    | keyword='break' ';'
    | keyword='continue' ';'
    | keyword='return' expression=commaExpression? ';'
    ;

/* A dangling else belongs to the nearest if. */
node ifStatement
    : 'if' '(' scopeOpen condition=commaExpression ')' then=statement ifScopeClose                       #IfStatement
    | 'if' '(' scopeOpen condition=commaExpression ')' then=statement Else otherwise=statement scopeClose #IfElseStatement
    ;

/* Selection and iteration statements are blocks since C99: a tag or an enumerator declared in them ends with them. */
node ifScopeClose -> popScope
    : empty #IfScopeClose
    ;

node constantExpression
    : value=conditionalExpression
    ;

node commaExpression
    : value=assignmentExpression
    | left=commaExpression op=',' right=assignmentExpression
    ;

node assignmentExpression
    : value=conditionalExpression
    | target=unaryExpression op=assignmentOperator source=assignmentExpression
    ;

inline assignmentOperator
    : value='='
    | value='*='
    | value='/='
    | value='%='
    | value='+='
    | value='-='
    | value='<<='
    | value='>>='
    | value='&='
    | value='^='
    | value='|='
    ;

node conditionalExpression
    : value=logicalOrExpression
    | condition=logicalOrExpression '?' then=commaExpression ':' otherwise=conditionalExpression
    | condition=logicalOrExpression '?' ':' otherwise=conditionalExpression
    ;

node logicalOrExpression
    : value=logicalAndExpression
    | left=logicalOrExpression op='||' right=logicalAndExpression
    ;

node logicalAndExpression
    : value=inclusiveOrExpression
    | left=logicalAndExpression op='&&' right=inclusiveOrExpression
    ;

node inclusiveOrExpression
    : value=exclusiveOrExpression
    | left=inclusiveOrExpression op='|' right=exclusiveOrExpression
    ;

node exclusiveOrExpression
    : value=andExpression
    | left=exclusiveOrExpression op='^' right=andExpression
    ;

node andExpression
    : value=equalityExpression
    | left=andExpression op='&' right=equalityExpression
    ;

node equalityExpression
    : value=relationalExpression
    | left=equalityExpression op='==' right=relationalExpression
    | left=equalityExpression op='!=' right=relationalExpression
    ;

node relationalExpression
    : value=shiftExpression
    | left=relationalExpression op='<' right=shiftExpression
    | left=relationalExpression op='>' right=shiftExpression
    | left=relationalExpression op='<=' right=shiftExpression
    | left=relationalExpression op='>=' right=shiftExpression
    ;

node shiftExpression
    : value=additiveExpression
    | left=shiftExpression op='<<' right=additiveExpression
    | left=shiftExpression op='>>' right=additiveExpression
    ;

node additiveExpression
    : value=multiplicativeExpression
    | left=additiveExpression op='+' right=multiplicativeExpression
    | left=additiveExpression op='-' right=multiplicativeExpression
    ;

node multiplicativeExpression
    : value=castExpression
    | left=multiplicativeExpression op='*' right=castExpression
    | left=multiplicativeExpression op='/' right=castExpression
    | left=multiplicativeExpression op='%' right=castExpression
    ;

node castExpression
    : value=unaryExpression
    | '(' type=typeName ')' operand=castExpression
    ;

node unaryExpression
    : value=postfixExpression
    | op='++' operand=unaryExpression
    | op='--' operand=unaryExpression
    | op=unaryOperator operand=castExpression
    | op='sizeof' operand=unaryExpression
    | op='sizeof' '(' type=typeName ')'
    | op=alignofKeyword operand=unaryExpression
    | op=alignofKeyword '(' type=typeName ')'
    | op='&&' label=anyName
    ;

inline alignofKeyword
    : value='alignof'
    | value='_Alignof'
    | value='__alignof'
    | value='__alignof__'
    ;

inline unaryOperator
    : value='__extension__'
    | value='__real__'
    | value='__real'
    | value='__imag__'
    | value='__imag'
    | value='&'
    | value='*'
    | value='+'
    | value='-'
    | value='~'
    | value='!'
    ;

node postfixExpression
    : value=primaryExpression
    | base=postfixExpression LeftBracket index=commaExpression RightBracket
    | base=postfixExpression '(' arguments=argumentExpressionList? ')'
    | base=postfixExpression op='.' member=anyName
    | base=postfixExpression op='->' member=anyName
    | base=postfixExpression op='++'
    | base=postfixExpression op='--'
    | '(' type=typeName ')' literal=bracedInitializer
    ;

node argumentExpressionList
    : value=argument
    | list=argumentExpressionList ',' item=argument
    ;

/* A type is an argument of builtins, such as __builtin_va_arg, or of attributes. */
inline argument
    : value=assignmentExpression
    | value=typeName
    ;

node primaryExpression
    : name=Identifier
    | value=constant
    | strings=StringLiteral+
    | '(' value=commaExpression ')'
    | '(' statements=compoundStatement ')'
    | '_Generic' '(' controlling=assignmentExpression ',' associations=genericAssociationList ')'
    ;

node genericAssociationList
    : value=genericAssociation
    | list=genericAssociationList ',' item=genericAssociation
    ;

node genericAssociation
    : type=typeName ':' value=assignmentExpression
    | keyword='default' ':' value=assignmentExpression
    ;

inline constant
    : value=IntegerConstant
    | value=FloatingConstant
    | value=CharacterConstant
    ;

Else
    : 'else'
    ;

AttributeWord
    : '__attribute__' | '__attribute'
    ;

StandardAttributeOpen
    : '[[' | '<:<:' | '[<:' | '<:['
    ;

/* Digraphs are other spellings of the same tokens, so the parser does not see them. */
LeftBracket
    : '[' | '<:'
    ;

RightBracket
    : ']' | ':>'
    ;

LeftBrace
    : '{' | '<%'
    ;

RightBrace
    : '}' | '%>'
    ;

AtomicWord
    : '_Atomic'
    ;

LeftParenthesis
    : '('
    ;

Colon
    : ':'
    ;

Identifier
    : NameStart ( NameStart | Digit ) *
    ;

/* Besides letters, a name takes universal character names, and $ as gcc allows. */
fragment NameStart
    : Nondigit | '$' | '\\' 'u' HexDigit HexDigit HexDigit HexDigit
    | '\\' 'U' HexDigit HexDigit HexDigit HexDigit HexDigit HexDigit HexDigit HexDigit
    ;

/* Never selected by the lexer, as Identifier comes first. */
TypedefName
    : NameStart ( NameStart | Digit ) * -> nameOf(Identifier)
    ;

/*
 * Numbers in their general form, as gcc has checked every file before the grammar sees
 * it. A number takes any suffix, and digits can be separated by an apostrophe.
 */
IntegerConstant
    : Digit ( Digit | Nondigit | '\'' ) *
    ;

FloatingConstant
    : ( Digits '.' Digits ? | '.' Digits ) Exponent ? NumberSuffix
    | Digits Exponent NumberSuffix
    | '0' [xX] ( HexDigits ( '.' HexDigits ? ) ? | '.' HexDigits ) [pP] [+-] ? Digits NumberSuffix
    ;

CharacterConstant
    : StringPrefix ? '\'' ( ~ ['\\\r\n] | EscapeSequence ) + '\''
    ;

StringLiteral
    : StringPrefix ? '"' ( ~ ["\\\r\n] | EscapeSequence ) * '"'
    ;

fragment StringPrefix
    : 'L' | 'u' | 'U' | 'u8'
    ;

fragment Digits
    : Digit ( Digit | '\'' ) *
    ;

fragment HexDigits
    : HexDigit ( HexDigit | '\'' ) *
    ;

fragment NumberSuffix
    : ( Nondigit | Digit ) *
    ;

fragment Digit
    : [0-9]
    ;

fragment NonzeroDigit
    : [1-9]
    ;

fragment OctalDigit
    : [0-7]
    ;

fragment HexDigit
    : [0-9a-fA-F]
    ;

fragment Nondigit
    : [a-zA-Z_]
    ;

fragment Exponent
    : [eE] [+-] ? Digit +
    ;

fragment EscapeSequence
    : '\\' ~ [\r\n]
    ;

Whitespace
    : [ \t] + -> channel ( HIDDEN )
    ;

Newline
    : ( '\r' '\n' ? | '\n' ) -> channel ( HIDDEN )
    ;

BlockComment
    : '/*' . * ? '*/' -> channel ( HIDDEN )
    ;

/*
 * What preprocessing leaves: line markers, #pragma and #ident. A directive starts a
 * line, which the lexer sees by taking the line break into the token: this match is
 * longer than Newline, while a # inside a line matches neither rule. Only a directive
 * on the first line of the file has no line break before it, so it stays visible, and
 * compilationUnit accepts it there.
 */
Directive
    : ( '\r' '\n' ? | '\n' ) [ \t] * '#' ~ [\r\n] * -> channel ( HIDDEN )
    ;

FirstDirective
    : '#' ~ [\r\n] *
    ;
